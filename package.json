{
  "name": "dsh-element-picker",
  "version": "0.11.3",
  "description": "Reference chips: one strip icon in the right sidebar turns elements, links and file paths into native composer chips — pick from DSH itself, same-origin frames, or the sidebar browser's webview guests; the chips serialize into the prompt and point back at what they name.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cdp.js",
    "bridge.js",
    "extension",
    "protocols.js",
    "PROTOCOL.md",
    "README.md",
    "CONTRIBUTORS.md",
    "LICENSE",
    "scripts/check-pack.mjs",
    "scripts/e2e.mjs",
    "cordis.patch.yml",
    "native/os-pick.ps1"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/check-pack.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakikoTGW/dsh-element-picker.git"
  },
  "homepage": "https://github.com/sakikoTGW/dsh-element-picker#readme",
  "bugs": {
    "url": "https://github.com/sakikoTGW/dsh-element-picker/issues"
  },
  "author": "sakikoTGW",
  "contributors": ["Knot-chord (PR #1: four-channel kernel, extension bridge, insert fallback, six-layer description)"],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "element-picker",
    "reference-chip"
  ]
}
